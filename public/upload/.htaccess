# Turn off handler mappings inside this physical directory boundary
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .phar

# Bounce requests targeting backend engine scripts inside the assets tree
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|pht|phar|sh|pl|py|exe|msi|bat|cmd)$">
    Require all denied
</FilesMatch>

# Force binary downloads on uploaded attachments to block cross-context script parsing
<FilesMatch "\.(pdf|doc|docx|xls|xlsx|ppt|pptx|csv|txt)$">
    Header set Content-Disposition "attachment"
    Header set X-Content-Type-Options "nosniff"
</FilesMatch>

# ======================================================================
# SECURE PERFORMANCE IMMUTABLE LIFESPANS
# ======================================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Images (1 Year Cache)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Videos (1 Month Cache)
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType video/webm "access plus 1 month"

    # Documents (1 Week Cache)
    ExpiresByType application/pdf "access plus 1 week"
    ExpiresByType application/msword "access plus 1 week"
    ExpiresByType application/vnd.openxmlformats-officedocument.wordprocessingml.document "access plus 1 week"
    ExpiresByType application/vnd.ms-excel "access plus 1 week"
    ExpiresByType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(mp4|webm)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>

    <FilesMatch "\.(pdf|doc|docx|xls|xlsx|ppt|pptx|csv)$">
        Header set Cache-Control "public, max-age=604800, must-revalidate"
    </FilesMatch>
</IfModule>